# Serves index.html for any path that isn't a real file/directory, so
# React Router's client-side routes (e.g. /documentaries, /picture-this)
# work on direct visit and on refresh under Apache-based hosting (Hostinger).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Without these, every visitor re-downloads every video and photo on every
# page view, because nothing tells the browser it may keep a copy.
<IfModule mod_expires.c>
  ExpiresActive On

  # Media filenames are stable and the files rarely change, so a long life is
  # safe. Replacing one means renaming it or clearing the Hostinger cache.
  ExpiresByType video/mp4          "access plus 1 year"
  ExpiresByType image/jpeg         "access plus 1 year"
  ExpiresByType image/png          "access plus 1 year"
  ExpiresByType image/svg+xml      "access plus 1 year"
  ExpiresByType font/woff2         "access plus 1 year"

  # The build gives these a content hash in the name, so a changed file is a
  # new URL and an old copy can never be served by mistake.
  ExpiresByType text/css           "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # immutable tells the browser not even to ask whether these changed.
  <FilesMatch "\.(mp4|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index-.*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached: it is what points at the current build,
  # so a stale copy would pin visitors to an old version of the site.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Video and images are already compressed; squeezing them again wastes CPU
# and gains nothing. Text is worth it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
