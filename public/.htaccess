# Serves index.html for any path that isn't a real file/directory, so
# React Router's client-side routes (e.g. /documentaries, /guided-session)
# work on direct visit and on refresh under Apache-based hosting (Hostinger).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
